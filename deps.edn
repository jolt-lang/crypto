{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; The JDK crypto classes jolt.crypto installs (RFC 0014). A JVM library reaches
 ;; for these with no install require — Selmer's {{ x|hash:"md5" }} filter calls
 ;; MessageDigest/getInstance — so declaring them here is what lets that work for
 ;; a project that depends on this library.
 ;;
 ;; SecureRandom is deliberately absent: the runtime implements it natively over
 ;; the OS CSPRNG, so reaching for it should not make a program declare a library.
 ;;
 ;; Fully-qualified only; jolt derives the simple spelling.
 :jolt/provides {jolt.crypto ["java.security.MessageDigest"
                              "javax.crypto.Mac"
                              "javax.crypto.Cipher"
                              "javax.crypto.spec.SecretKeySpec"
                              "javax.crypto.spec.IvParameterSpec"
                              "java.security.Signature"
                              "java.security.KeyPairGenerator"
                              "java.security.KeyFactory"
                              "java.security.spec.ECGenParameterSpec"
                              "java.security.spec.X509EncodedKeySpec"
                              "java.security.spec.PKCS8EncodedKeySpec"
                              "java.security.cert.CertificateFactory"
                              "java.security.cert.X509Certificate"
                              "javax.security.auth.x500.X500Principal"]}

 ;; OpenSSL (libcrypto for the symmetric primitives here; libssl so dependents
 ;; that also do TLS — e.g. jolt-lang/http-client — get both from one place and
 ;; don't redeclare them). Declared :jolt/native so jolt loads them before this
 ;; namespace, where the foreign-fn bindings resolve at load. An app pulling both
 ;; this and http-client loads each library once — jolt.deps reconciles natives.
 ;;
 ;; A platform with no key here is searched for NOTHING — jolt.main/load-natives!
 ;; reads exactly the key the running platform selects — so declaring only
 ;; :darwin/:linux made every dependent app fail on Windows with "required native
 ;; library crypto not found — tried []", however completely the DLLs were on
 ;; PATH (jolt-lang/jolt#990). The Windows names are the version-suffixed ones
 ;; OpenSSL's own builds ship, which is what Git for Windows installs and what
 ;; jolt's own Maven fetcher already looks for (stdlib/jolt/mvn_http.clj). They
 ;; are bare, so the standard loader search order applies: the executable's
 ;; directory (the DLLs beside jolt.exe) and PATH both work.
 ;;
 ;; macOS: never /usr/lib/libcrypto.dylib or a bare "libcrypto.dylib", which
 ;; dyld resolves to the same file. That is Apple's stub, and it ABORTS the
 ;; process that opens it ("loading libcrypto in an unsafe way") — a machine
 ;; without OpenSSL installed died instead of reporting the library missing. The
 ;; candidates are where OpenSSL 3 is installed (Homebrew on Apple silicon and on
 ;; Intel, MacPorts), then the versioned bare name, which dyld does not map to
 ;; the stub and finds on DYLD_LIBRARY_PATH or the default fallback path
 ;; (/usr/local/lib holds Homebrew's links on Intel).
 ;;
 ;; :link-libs is what libcrypto.a itself links against — OpenSSL's own
 ;; Libs.private for its mingw and linux targets — for an app that links these
 ;; libraries statically by overlaying a :static archive (jolt 0.8.16 and later;
 ;; an older jolt ignores the key). libssl.a needs nothing beyond libcrypto.
 :jolt/native [{:name "crypto"
                :darwin  ["/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib"
                          "/usr/local/opt/openssl@3/lib/libcrypto.3.dylib"
                          "/opt/local/lib/libcrypto.3.dylib"
                          "libcrypto.3.dylib"]
                :linux   ["libcrypto.so.3" "libcrypto.so.1.1" "libcrypto.so"]
                :windows ["libcrypto-3-x64.dll" "libcrypto-3.dll"
                          "libcrypto-1_1-x64.dll" "libcrypto.dll"]
                :link-libs {:windows ["ws2_32" "gdi32" "crypt32"]
                            :linux   ["dl" "pthread"]}}
               {:name "ssl"
                :darwin  ["/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib"
                          "/usr/local/opt/openssl@3/lib/libssl.3.dylib"
                          "/opt/local/lib/libssl.3.dylib"
                          "libssl.3.dylib"]
                :linux   ["libssl.so.3" "libssl.so.1.1" "libssl.so"]
                :windows ["libssl-3-x64.dll" "libssl-3.dll"
                          "libssl-1_1-x64.dll" "libssl.dll"]}]

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "jolt.crypto-test"]}}

 :tasks {test "jolt -M:test"}}
