;; What ci/metrics-gate.clj holds the jolt-metrics report to.
;;
;; :critical-free: path prefixes where a CRITICAL finding (a function over the
;; cyclomatic, cognitive, lines, nesting or params limit, or a file over 1000
;; source lines) or a file jolt-metrics cannot read fails the build.
;;
;; :criticals: critical findings that stay on purpose. Each one records the
;; value of every rule it breaks and fails once any of them gets worse or a new
;; rule goes critical. Delete an entry when its finding drops below the critical
;; limits; the gate fails on a stale one.
;;
;; :unused-requires, :unused-private, :unused-public and :lints are unused code
;; and lint findings that stay on purpose, as in jolt's ci/metrics-allow.edn.
;; A :lints entry names a path, a rule and how many findings of it the file
;; keeps. Every entry needs a :why.
{:critical-free ["src/" "test/"]
 :criticals
 [{:path "src/jolt/crypto.clj" :name "src/jolt/crypto.clj"
   :limits {:hotspot 1.0}
   :why "hotspot risk is churn-driven: as the repo's most complex file its score is its commit count over the last 90 days out of 20, so no refactor keeps it under 0.8. :hotspot is set to its maximum and every other rule (file-lines included) still gates"}]
 :unused-requires []
 :unused-private []
 :unused-public
 [{:path "src/jolt/crypto.clj" :name "ed-private-bytes"
   :why "public since 0.4.0 and documented as JWK-internal, but nothing calls it; removing it changes the public API"}]
 :lints
 [{:path "test/jolt/crypto/certificates_test.clj" :rule :refer-all :count 1
   :why "clojure.test :refer :all, as in the Buddy Core tests it was ported from"}
  {:path "test/jolt/crypto/keys_jwk_test.clj" :rule :refer-all :count 1
   :why "clojure.test :refer :all, as in the Buddy Core tests it was ported from"}
  {:path "test/jolt/crypto/keys_test.clj" :rule :refer-all :count 1
   :why "clojure.test :refer :all, as in the Buddy Core tests it was ported from"}
  {:path "test/jolt/crypto/util/ecdsa_test.clj" :rule :refer-all :count 1
   :why "clojure.test :refer :all, as in the Buddy Core tests it was ported from"}]}
